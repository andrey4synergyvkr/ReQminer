# Ключ провайдера (обязателен для облачного режима).
LLM_API_KEY=

# Шлюз для доступа к облачной LLM.
LLM_BASE_URL=https://routerai.ru/api

# Модель провайдера.
LLM_MODEL=~z-ai/glm-latest

# Кэш ответов модели по хэшу промпта.
LLM_CACHE=1

# Число параллельно используемых запросов к LLM.
LLM_CONCURRENCY=4

# PostgreSQL для хранилищ Chunks и реестра.
DATABASE_URL=postgresql+psycopg://reqminer:reqminer@localhost:5432/reqminer

# Neo4j для хранилища Knowledge.
# Без NEO4J_URI граф фактов живет в памяти процесса.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reqminer
